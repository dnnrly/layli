layout: absolute

path:
  algorithm: astar
  heuristic: euclidean
  cost-function: horizontal-vertical

nodes:
  - id: node1
    contents: "Start"
    position: {x: 2, y: 5}
  - id: node2
    contents: "Top Right"
    position: {x: 15, y: 2}
  - id: node3
    contents: "Bottom Right"
    position: {x: 15, y: 10}
  - id: node4
    contents: "Center"
    position: {x: 8, y: 6}

edges:
  - from: node1
    to: node2
  - from: node1
    to: node3
  - from: node2
    to: node4
  - from: node3
    to: node4

width: 4
height: 4
border: 1
margin: 1
